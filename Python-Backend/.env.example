# Groq API Key (FREE - Get from https://console.groq.com)
# Sign up at console.groq.com and create an API key
GROQ_API_KEY=your_groq_api_key_here

# Node.js Backend URL (for webhook callbacks)
# Development: http://localhost:8000
# Production: https://your-backend-api.com
NODE_WEBHOOK_URL=http://localhost:8000

# Server Configuration
PORT=5000

# LLM Configuration
# Available models: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
LLM_MODEL=llama-3.1-8b-instant

# Embedding Model (for vector embeddings)
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Your site info
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=FinChatBot

# Tesseract OCR Configuration (Windows)
# Path to tesseract.exe for OCR functionality
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# Mac: /usr/local/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
