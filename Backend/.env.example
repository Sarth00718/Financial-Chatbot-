# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from https://www.mongodb.com/atlas
# Local MongoDB: mongodb://localhost:27017/finchatbot
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/finchatbot
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finchatbot

# CORS Configuration (Frontend URL)
# Development: http://localhost:5173
# Production: https://your-domain.com
CORS_ORIGIN=https://your-frontend-domain.com

# Python Backend URL (for AI processing)
# Development: http://localhost:5000
# Production: https://your-python-api.com
PYTHON_SERVICE_URL=https://your-python-api.com

# JWT Configuration
# IMPORTANT: Generate secure random strings for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email Configuration (for password reset)
# For development, you can use Ethereal Email (https://ethereal.email/)
# For production, use Gmail, SendGrid, or other SMTP service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=FinChatBot <noreply@finchatbot.com>

# Frontend URL (for email links)
# Development: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=https://your-frontend-domain.com
